[Unit]
Description=Fiestas — agendador do Laravel
After=network.target postgresql.service

[Service]
Type=oneshot
User=deploy
Group=www-data
WorkingDirectory=/var/www/fiestas
ExecStart=/usr/bin/php artisan schedule:run

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/www/fiestas/storage /var/www/fiestas/bootstrap/cache
