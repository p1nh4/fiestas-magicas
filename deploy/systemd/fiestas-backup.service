[Unit]
Description=Fiestas — cópia de segurança diária
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/var/www/fiestas
ExecStart=/bin/bash deploy/backup.sh

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/backups/fiestas
