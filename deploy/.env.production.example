# Produção. Copiar para .env na raiz do projeto e preencher.
#
# Este ficheiro NUNCA vai para o git. O .env de produção tem a password da
# base de dados e a APP_KEY — com a APP_KEY, quem a tiver lê as sessões e
# desfaz o hash dos IPs guardados nos leads.
#
#     chmod 600 .env

APP_NAME="Fiestas Mágicas Galicia"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://DOMINIO.TLD
APP_TIMEZONE=Europe/Madrid
APP_LOCALE=es

# APP_DEBUG=false não é um pormenor: com true, qualquer erro mostra ao
# visitante o caminho dos ficheiros, o conteúdo do .env e as queries com os
# valores lá dentro.

# ------------------------------------------------------------------ base de dados
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=fiestas
DB_USERNAME=fiestas
DB_PASSWORD=

# ------------------------------------------------------------------ sessões e filas
# Tudo na base de dados. Sem Redis: é mais um serviço para manter e a esta
# escala não ganha nada.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=database
CACHE_STORE=database

# ------------------------------------------------------------------ logs
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

# ------------------------------------------------------------------ email
# Sem custos: um SMTP que já tenhas. Enquanto estiver vazio, o Laravel
# escreve os emails no log em vez de os enviar — o que serve para testar,
# mas não serve para responder a uma cliente.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hola@DOMINIO.TLD"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------ empresa
BUSINESS_PHONE=+34684291843
BUSINESS_WHATSAPP=34684291843
BUSINESS_EMAIL=
BUSINESS_INSTAGRAM=fiestas_magicas_en_galicia
BUSINESS_FACEBOOK=
BUSINESS_CITY="Sabarís, Baiona"
BUSINESS_POSTAL_CODE=36393
BUSINESS_STREET=

BUSINESS_REF_PREFIX=FM
EVENT_DEFAULT_START_HOUR=12
EVENT_DEFAULT_HOURS=6

# ------------------------------------------------------------------ orçamentos
# Por confirmar com a Sol.
QUOTE_DEPOSIT_PCT=30
QUOTE_VALID_DAYS=15
VAT_RATE=21

# ------------------------------------------------------------------ pagamentos
# Vazio = passarela falsa (não cobra nada). Só preencher quando a empresa
# estiver formalizada e houver conta Stripe.
PAYMENT_GATEWAY=fake
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
