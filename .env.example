APP_NAME="DecorArte Fiestas Mágicas"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Idiomas: es (padrão), gl, pt. O fallback nunca é null — se faltar uma
# tradução queremos texto em espanhol, não uma chave crua no ecrã.
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=Europe/Madrid

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- PostgreSQL ---------------------------------------------------------
# Postgres e não MariaDB por causa de tstzrange + índices gist: é o que
# torna o controlo de stock verificável pela base de dados.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=fiestas
DB_USERNAME=fiestas
DB_PASSWORD=fiestas

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

# Em produção passar para redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

FILESYSTEM_DISK=public

# --- Email --------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hola@fiestasmagicas.gal"
MAIL_FROM_NAME="${APP_NAME}"

# --- Negócio ------------------------------------------------------------
BUSINESS_PHONE="+34684291843"
BUSINESS_WHATSAPP="34684291843"
BUSINESS_CITY="Sabarís, Baiona"
BUSINESS_POSTAL_CODE="36393"
BUSINESS_INSTAGRAM="fiestas_magicas_en_galicia"
QUOTE_DEPOSIT_PCT=30
QUOTE_VALID_DAYS=15
VAT_RATE=21

# --- Stripe (deixar vazio até haver conta) ------------------------------
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# --- Cloudflare Turnstile (anti-spam do formulário) ---------------------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
